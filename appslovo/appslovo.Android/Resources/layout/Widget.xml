<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >


    	<FrameLayout
		android:padding="7dip"
		android:id="@+id/widgetBackground"
		android:background="@drawable/postblock"
		android:divider="#00FFFFFF"
		android:dividerHeight="1px"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:layout_marginLeft="0.0dp">

		<FrameLayout
			
			android:layout_width="match_parent"
			android:layout_height="35dip"
			android:visibility="gone"
			android:background="@drawable/nameblock"
			android:id="@+id/widgetPostNameBlock"
            >
			<FrameLayout
                android:layout_width="13dip"
                android:layout_height="13dip"
				android:background="@drawable/sign"
				android:layout_marginTop="10dip"
				android:layout_marginLeft="3dip"/>
			<LinearLayout
				android:layout_height="match_parent"
				android:layout_width="match_parent"
				android:layout_marginTop="1dip"
				android:gravity="center_horizontal">
				<TextView
					android:padding="4dip"
		android:textAlignment="center"
					android:layout_height="match_parent"
					android:layout_width="wrap_content"
					android:text=""
					android:textColor="#A9A9A9"
					android:id="@+id/widgetPostName"
					android:textSize="15dip"
				

					/>

			</LinearLayout>

		</FrameLayout>
		<LinearLayout
			android:paddingTop="35dip"
			android:paddingHorizontal="7dip"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
			android:orientation="vertical"
			>
			
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
				android:textColor="#D8D8D8"
				android:textSize="15dip"
				android:paddingBottom="2dip"
				android:visibility="gone"
				android:paddingTop="4dip"
				android:fontFamily="Inter"
            android:id="@+id/widgetPostText"
            android:text="" />
			<TextView
				android:layout_width="match_parent"
				android:layout_height="30dip"
				android:textColor="#A9A9A9"
				android:textSize="24dip"
				android:textAlignment="center"
				android:visibility="gone"
				android:fontFamily="Inter"
				android:id="@+id/widgetErrorText1"
				android:text="no posts yet." />
			       <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
				android:textColor="#596AC7"
				android:textSize="10dip"
				android:textAlignment="center"
				android:visibility="gone"
				android:fontFamily="Inter"
            android:id="@+id/widgetErrorText2"
            android:text="tap to update" />
			<TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
				android:textColor="#596AC7"
				android:textSize="16dip"
				
				android:id="@+id/widgetGlobalError"
				android:fontFamily="Inter"
            
            android:text="error!\n\nplease, reset the widget" />
        </LinearLayout>

	</FrameLayout>
	<LinearLayout
		android:layout_marginTop="-26dip"
        android:layout_width="match_parent"
		
		android:gravity="center_horizontal"
        android:layout_height="21dip">
		<LinearLayout
            android:layout_width="90dip"
            android:layout_height="match_parent"
			android:background="@drawable/timeblock"
			android:paddingTop="3dip"
			android:paddingHorizontal="17dip"
					android:orientation="horizontal">
		<TextView
            android:layout_width="16dip"
            android:layout_height="12dip"
				android:textColor="#596AC7"
				android:textSize="11dip"
				android:textAlignment="center"
		android:paddingEnd="2dip"
				android:id="@+id/widgetTimerHours"
				android:fontFamily="Inter"
		
            android:textFontWeight="800"
            android:text="00" />
		<TextView
            android:layout_width="5dip"
            android:layout_height="12dip"
				android:textColor="#596AC7"
				android:textSize="11dip"
				android:textAlignment="center"
		android:paddingEnd="2dip"
				
				android:fontFamily="Inter"
		
            android:textFontWeight="800"
            android:text=":" />
	<TextView
            android:layout_width="16dip"
            android:layout_height="12dip"
				android:textColor="#596AC7"
				android:textSize="11dip"
				android:textAlignment="center"
		android:paddingEnd="2dip"
				android:id="@+id/widgetTimerMinutes"
				android:fontFamily="Inter"

            android:textFontWeight="800"
            android:text="00" />
				<TextView
            android:layout_width="5dip"
            android:layout_height="12dip"
				android:textColor="#596AC7"
				android:textSize="11dip"
				android:textAlignment="center"
		android:paddingEnd="2dip"
				
				android:fontFamily="Inter"
		
            android:textFontWeight="800"
            android:text=":" />
	<TextView
            android:layout_width="16dip"
			
            android:layout_height="12dip"
				android:textColor="#596AC7"
				android:textSize="11dip"
				android:textAlignment="center"
		android:paddingEnd="2dip"
				android:id="@+id/widgetTimerSeconds"
				android:fontFamily="Inter"
            android:textFontWeight="800"
            android:text="00" />
			</LinearLayout>
		</LinearLayout>
</LinearLayout>

