<?xml version="1.0" encoding="utf-8" ?>
    
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="appslovo.PhoneLog"
             xmlns:effects="clr-namespace:PlainEntryAndroidSample.Effects"
             >
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="entrystyle" TargetType="Entry">

                <Setter Property="TextColor" Value="{DynamicResource Key=blue}" />
                <Setter Property="HeightRequest" Value="30" />
                <Setter Property="PlaceholderColor" Value="#a9a9a9" />
                <Setter Property="BackgroundColor" Value="Transparent"/>
            </Style>
            <Style x:Key="appslovo.PhoneLog" TargetType="AbsoluteLayout">
                <Setter Property="Background"  Value="{DynamicResource Key=darkbgcolor}"/>
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <AbsoluteLayout>
            
            <Label
                Text="Brief"
                TextColor="White"
                FontSize="40"
                HorizontalTextAlignment="Center"
                AbsoluteLayout.LayoutFlags="PositionProportional"
                AbsoluteLayout.LayoutBounds=".5,.03,110,100"
                FontFamily="Inter"/>

            <Label x:Name="phone_input_error"
    WidthRequest="1600"
   TextColor="{DynamicResource Key=red}"
   Text="" 
   AbsoluteLayout.LayoutFlags="XProportional"
   AbsoluteLayout.LayoutBounds=".5,280,200,100"
                   HorizontalTextAlignment="Center"/>


            <Frame HorizontalOptions="EndAndExpand" AbsoluteLayout.LayoutFlags="PositionProportional" AbsoluteLayout.LayoutBounds=".94,.45,50,50" Padding="0" BackgroundColor="Transparent">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="getid"/>
                </Frame.GestureRecognizers>

                <Frame Padding="17" IsClippedToBounds="True" Margin="0,5,0,0" BackgroundColor="Transparent">
                    <StackLayout>
                        <BoxView Color="{DynamicResource Key=blue}" HeightRequest="3" Rotation="45" Margin="0,-2,0,0"  CornerRadius="1"/>
                        <BoxView Color="{DynamicResource Key=blue}" HeightRequest="3" Rotation="-45" Margin="0,1,0,0" CornerRadius="1"/>
                    </StackLayout>
                </Frame>
            </Frame>


            <Frame  HasShadow="False"
                   Padding="20,7,0,10"
                   BackgroundColor="{DynamicResource Key=darkframecolor}"
                   CornerRadius="15"
                AbsoluteLayout.LayoutFlags="PositionProportional"
                AbsoluteLayout.LayoutBounds=".5,.45,251,66">
                
                    <Entry HeightRequest="50"
Style="{StaticResource entrystyle}"
                    CharacterSpacing="1.5"
            Placeholder="Phone number"
            MaxLength="12"
            x:Name="enrt"
            Keyboard="Telephone"
                          
            Completed="getid"
                        VerticalOptions="CenterAndExpand"
                    HorizontalTextAlignment="Start"
                    FontFamily="Inter"
                    FontSize="20">
                    <Entry.Effects>
                        <effects:PlainEntry/>
                    </Entry.Effects>
                </Entry>

                   
            </Frame>

        </AbsoluteLayout>
    </ContentPage.Content>
</ContentPage>
